---
// Translucent macOS-style menu bar pinned to the top of the viewport.
---
<div class="dw-menubar" role="menubar">
  <div class="dw-menubar-left">
    <button type="button" class="dw-menu-item dw-apple" aria-label="Apple menu">
      <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
        <path d="M13.6 10.6c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.8-3.2.8-.7 0-1.7-.8-2.8-.7-1.4 0-2.7.8-3.5 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7 1.3 0 1.7.7 2.8.7 1.2 0 1.9-1 2.6-2 .8-1.1 1.2-2.3 1.2-2.3-.1 0-2.3-.9-2.5-3.4M11.6 4.2c.6-.7 1-1.7.9-2.7-.8 0-1.9.5-2.5 1.3-.5.6-1 1.6-.9 2.6.9.1 1.9-.5 2.5-1.2"/>
      </svg>
    </button>
    <button type="button" class="dw-menu-item dw-menu-item-bold" data-scramble>Portfolio</button>
    <button type="button" class="dw-menu-item dw-menu-hide-mobile" data-scramble>File</button>
    <button type="button" class="dw-menu-item dw-menu-hide-mobile" data-scramble>Edit</button>
    <button type="button" class="dw-menu-item dw-menu-hide-mobile" data-scramble>View</button>
    <button type="button" class="dw-menu-item dw-menu-hide-mobile" data-scramble>Window</button>
    <button type="button" class="dw-menu-item dw-menu-hide-mobile" data-scramble>Help</button>
  </div>
  <div class="dw-menubar-right">
    <span class="dw-menu-icon" aria-hidden="true">􀋚</span>
    <span class="dw-menu-icon" aria-hidden="true">􀹖</span>
    <span class="dw-menu-item" id="dw-clock">—</span>
  </div>
</div>

<style>
  .dw-menubar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    background: rgba(20, 20, 20, 0.65);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    z-index: 1000;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Geist Variable", sans-serif;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.92);
  }
  .dw-menubar-left,
  .dw-menubar-right {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .dw-menu-item {
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    padding: 3px 10px;
    border-radius: 4px;
    cursor: default;
    line-height: 1;
  }
  .dw-menu-item:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .dw-menu-item-bold { font-weight: 600; }
  .dw-apple { padding: 4px 8px; display: inline-flex; align-items: center; }
  .dw-menu-icon {
    padding: 3px 8px;
    font-size: 12px;
    opacity: 0.85;
  }
  #dw-clock {
    font-variant-numeric: tabular-nums;
    min-width: 130px;
    text-align: right;
  }
  @media (max-width: 768px) {
    .dw-menu-hide-mobile { display: none; }
    .dw-menu-icon { display: none; }
    .dw-menubar { padding: 0 8px; }
    #dw-clock { min-width: 0; font-size: 12px; padding: 3px 6px; }
    .dw-menu-item { padding: 3px 6px; }
  }
</style>

<script>
  const el = document.getElementById('dw-clock');
  const tick = () => {
    if (!el) return;
    const d = new Date();
    const day = d.toLocaleDateString(undefined, { weekday: 'short' });
    const date = d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    const time = d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
    el.textContent = `${day} ${date}  ${time}`;
  };
  tick();
  setInterval(tick, 1000 * 15);
</script>
