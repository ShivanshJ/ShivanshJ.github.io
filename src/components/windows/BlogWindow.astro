---
import { getCollection } from 'astro:content';
import Window from '../desktop/Window.astro';

const posts = (await getCollection('blog')).sort((a, b) => a.data.order - b.data.order);

const readingTime = (raw: string) => {
  const words = raw.trim().split(/\s+/).length;
  const mins = Math.max(1, Math.round(words / 220));
  return `${mins} min`;
};

// Pre-render every post so we can server-render all bodies and JS just
// toggles visibility. Fast, keyboard-friendly, no fetch on switch.
const rendered = await Promise.all(
  posts.map(async (p) => ({
    slug: p.slug,
    data: p.data,
    reading: readingTime(p.body ?? ''),
    Content: (await p.render()).Content,
  })),
);

const fmtDate = (iso: string) => {
  try {
    return new Date(iso).toLocaleDateString(undefined, {
      year: 'numeric', month: 'short', day: 'numeric',
    });
  } catch { return iso; }
};
---
<Window id="blog" title="Blog" x={40} y={40} width={1000} height={720} fullscreen>
  <div class="dw-blog">
    <aside class="dw-blog-sidebar" aria-label="Posts">
      <p class="dw-blog-sidebar-title">
        <span class="dw-blog-sidebar-prompt">&gt;_</span> blog.log
      </p>
      <ul class="dw-blog-sidebar-list" role="listbox">
        {rendered.map((p, i) => (
          <li>
            <button
              type="button"
              class={`dw-blog-sidebar-item ${i === 0 ? 'is-active' : ''}`}
              data-blog-index={i}
              role="option"
              aria-selected={i === 0}
            >
              <span class="dw-blog-sidebar-num">[{String(i + 1).padStart(2, '0')}]</span>
              <span class="dw-blog-sidebar-body">
                <span class="dw-blog-sidebar-name" data-scramble>{p.data.title}</span>
                <span class="dw-blog-sidebar-meta">
                  <time datetime={p.data.date}>{fmtDate(p.data.date)}</time>
                  <span class="dw-blog-sidebar-dot">·</span>
                  <span>{p.reading}</span>
                </span>
                <span class="dw-blog-topic-pill">{p.data.topic}</span>
              </span>
            </button>
          </li>
        ))}
      </ul>
      <p class="dw-blog-sidebar-count">
        <span class="dw-blog-sidebar-count-num">{rendered.length}</span> posts
      </p>
    </aside>

    <section class="dw-blog-reader" aria-live="polite">
      {rendered.map((p, i) => (
        <article class="dw-blog-pane" data-blog-pane={i} hidden={i !== 0}>
          <header class="dw-blog-post-head">
            <p class="dw-blog-post-kicker">
              <time datetime={p.data.date}>{fmtDate(p.data.date)}</time>
              <span class="dw-blog-sidebar-dot">·</span>
              <span>{p.reading} read</span>
              <span class="dw-blog-sidebar-dot">·</span>
              <span class="dw-blog-topic-pill">{p.data.topic}</span>
            </p>
            <h1 class="dw-blog-post-title">{p.data.title}</h1>
            {p.data.description && (
              <p class="dw-blog-post-desc">{p.data.description}</p>
            )}
          </header>

          <div class="dw-blog-prose">
            <p.Content />
          </div>
        </article>
      ))}
    </section>
  </div>
</Window>

<style>
  .dw-blog {
    display: grid;
    grid-template-columns: 340px 1fr;
    gap: 0;
    height: calc(100% + 40px);
    margin: -20px -24px;
  }

  /* Sidebar mirrors WorkWindow's index pattern */
  .dw-blog-sidebar {
    display: flex;
    flex-direction: column;
    border-right: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.015);
    padding: 16px 0 0;
    overflow-y: auto;
  }
  .dw-blog-sidebar-title {
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--muted);
    margin: 0 16px 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }
  .dw-blog-sidebar-prompt { color: var(--accent); font-weight: 700; margin-right: 4px; }

  .dw-blog-sidebar-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .dw-blog-sidebar-item {
    width: 100%;
    display: flex;
    align-items: flex-start;
    gap: 8px;
    padding: 10px 16px 10px 12px;
    background: transparent;
    border: 0;
    border-left: 3px solid transparent;
    color: var(--text);
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    font-size: 12px;
    text-align: left;
    cursor: pointer;
    transition: background 120ms ease, border-color 120ms ease, color 120ms ease;
  }
  .dw-blog-sidebar-item:hover {
    background: rgba(76, 139, 245, 0.06);
    color: var(--accent);
  }
  .dw-blog-sidebar-item.is-active {
    background: rgba(76, 139, 245, 0.10);
    border-left-color: var(--accent);
  }
  .dw-blog-sidebar-item.is-active .dw-blog-sidebar-name { color: var(--accent); }
  .dw-blog-sidebar-num {
    color: var(--accent);
    font-weight: 700;
    letter-spacing: 0.06em;
    padding-top: 1px;
    flex-shrink: 0;
  }
  .dw-blog-sidebar-body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }
  .dw-blog-sidebar-name {
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    text-wrap: pretty;
  }
  .dw-blog-sidebar-meta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 10px;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .dw-blog-sidebar-dot { opacity: 0.5; }
  .dw-blog-sidebar-count {
    margin: auto 0 0;
    padding: 10px 16px 12px;
    border-top: 1px solid var(--border);
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--muted);
    background: rgba(255, 255, 255, 0.015);
  }
  .dw-blog-sidebar-count-num { color: var(--accent); font-weight: 700; }

  /* Reader pane */
  .dw-blog-reader {
    padding: 40px 56px 80px;
    overflow-y: auto;
    min-width: 0;
  }
  .dw-blog-pane[hidden] { display: none; }
  .dw-blog-pane { animation: dw-blog-in 240ms cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes dw-blog-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: none; }
  }

  .dw-blog-post-head {
    max-width: 68ch;
    margin: 0 auto 32px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .dw-blog-post-kicker {
    margin: 0 0 14px;
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dw-blog-post-title {
    font-family: "Charter", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--text);
    text-wrap: pretty;
  }
  .dw-blog-post-desc {
    margin: 14px 0 0;
    font-family: "Charter", Georgia, serif;
    font-style: italic;
    font-size: 17px;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.72);
    text-wrap: pretty;
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-blog-index]');
  const panes = document.querySelectorAll<HTMLElement>('[data-blog-pane]');
  const reader = document.querySelector<HTMLElement>('.dw-blog-reader');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = btn.getAttribute('data-blog-index');
      if (idx === null) return;
      if (!btn.classList.contains('is-active')) {
        (window as any).__dwChirp?.();
      }
      buttons.forEach((b) => {
        const active = b === btn;
        b.classList.toggle('is-active', active);
        b.setAttribute('aria-selected', String(active));
      });
      panes.forEach((p) => {
        const match = p.getAttribute('data-blog-pane') === idx;
        if (match) p.removeAttribute('hidden');
        else p.setAttribute('hidden', '');
      });
      // scroll reader back to top on switch
      if (reader) reader.scrollTop = 0;
    });
  });
</script>
