---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import { readingTime, fmtDate } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const reading = `${readingTime(post.body ?? '')} min read`;
const date    = fmtDate(post.data.date, { year: 'numeric', month: 'long', day: 'numeric' });
const canonicalUrl = `${site.url}/blog/${post.slug}`;
---

<Base title={`${post.data.title} — ${site.name}`} description={post.data.description}>
  <Fragment slot="head">
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={post.data.date} />
  </Fragment>

  <main class="article-shell">
    <nav class="article-nav">
      <a href="/blog" class="article-back">&larr; All posts</a>
    </nav>

    <article class="article-body">
      <header class="article-header">
        <p class="article-kicker">
          <time datetime={post.data.date}>{date}</time>
          <span class="dot">·</span>
          <span>{reading}</span>
          <span class="dot">·</span>
          <span class="article-topic">{post.data.topic}</span>
        </p>
        <h1 class="article-title">{post.data.title}</h1>
        {post.data.description && (
          <p class="article-desc">{post.data.description}</p>
        )}
      </header>

      <div class="article-prose blog-prose">
        <Content />
      </div>
    </article>

    <footer class="article-footer">
      <a href="/blog" class="article-back">&larr; All posts</a>
    </footer>
  </main>
</Base>

<style>
  .article-shell {
    max-width: 72ch;
    margin: 0 auto;
    padding: 48px 24px 96px;
  }

  .article-nav {
    margin-bottom: 40px;
  }

  .article-back {
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    font-size: 12px;
    letter-spacing: 0.06em;
    color: var(--muted);
    text-decoration: none;
    transition: color 120ms ease;
  }
  .article-back:hover { color: var(--accent); }

  .article-header {
    margin-bottom: 48px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--border);
  }

  .article-kicker {
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 16px;
  }

  .dot { opacity: 0.5; }

  .article-topic {
    background: var(--accent-soft);
    color: var(--accent);
    border-radius: 4px;
    padding: 2px 7px;
    font-size: 10px;
    letter-spacing: 0.12em;
  }

  .article-title {
    font-family: "Charter", "Iowan Old Style", "Palatino Linotype", Georgia, serif;
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 44px);
    line-height: 1.15;
    letter-spacing: -0.015em;
    margin: 0;
    color: var(--text);
    text-wrap: pretty;
  }

  .article-desc {
    margin: 16px 0 0;
    font-family: "Charter", Georgia, serif;
    font-style: italic;
    font-size: 17px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.72);
    text-wrap: pretty;
  }

  /* Typography comes from .blog-prose in desktop.css — no overrides here */

  .article-footer {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
  }
</style>

<script>
  import '../../scripts/ascii-image.ts';
</script>
