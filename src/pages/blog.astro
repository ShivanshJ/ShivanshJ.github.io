---
// Deep-link route: /blog renders the whole desktop but auto-opens the
// Blog window on load. Same static build as / — no server needed.
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Desktop from '../components/Desktop.astro';

const posts = (await getCollection('blog')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date),
);
---
<Base title="Blog — Shivansh Jagga" description="Long-form writing on probability, systems, and design.">
  <Desktop />
  {/* Crawler-visible article links — hidden when JS runs */}
  <noscript>
    <main style="max-width:72ch;margin:0 auto;padding:48px 24px;font-family:sans-serif;color:#fff;background:#232323">
      <h1 style="font-size:2rem;margin-bottom:2rem">Blog</h1>
      <ul style="list-style:none;padding:0;display:flex;flex-direction:column;gap:1.5rem">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.slug}`} style="color:#4C8BF5;text-decoration:none;font-size:1.1rem;font-weight:600">{p.data.title}</a>
            <p style="margin:4px 0 0;color:rgba(255,255,255,0.6);font-size:0.9rem">{p.data.description}</p>
          </li>
        ))}
      </ul>
    </main>
  </noscript>
</Base>

<script>
  // desktop.ts exposes __dwOpen; wait for it to attach, then open the
  // Blog window. Polls briefly rather than assuming load order.
  (() => {
    const tryOpen = (attempts: number) => {
      const open = (window as any).__dwOpen;
      if (typeof open === 'function') {
        open('blog');
        return;
      }
      if (attempts > 0) setTimeout(() => tryOpen(attempts - 1), 30);
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => tryOpen(20));
    } else {
      tryOpen(20);
    }
  })();
</script>
