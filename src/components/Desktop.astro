---
import { getCollection } from 'astro:content';
import BlogWindow from './windows/BlogWindow.astro';
import MenuBar from './desktop/MenuBar.astro';
import Dock from './desktop/Dock.astro';
import DesktopIcon from './desktop/DesktopIcon.astro';
import HeroPlate from './desktop/HeroPlate.astro';
import ReadmeWindow from './windows/ReadmeWindow.astro';
import WorkWindow from './windows/WorkWindow.astro';
import SignalWindow from './windows/SignalWindow.astro';
import ContactWindow from './windows/ContactWindow.astro';
import SnakeWindow from './windows/SnakeWindow.astro';
import AdminWindow from './windows/AdminWindow.astro';
import type { Signal } from './desktop/SignalTile.astro';

const workEntries = (await getCollection('work')).sort(
  (a, b) => a.data.order - b.data.order,
);

const blogEntries = (await getCollection('blog')).sort(
  (a, b) => b.data.date.localeCompare(a.data.date),
);

const signals: Signal[] = [
  { label: 'education',   title: 'Cornell University — MS, CS',    detail: '3.8 GPA · Merit Scholarship',                     year: '2022' },
  { label: 'startup',     title: 'Tanagram Lore',                  detail: 'Raised ~$5M · built a team of 7',                 year: '2026', href: 'https://lore.link' },
  { label: 'startup',     title: 'Verda.ai',                       detail: 'Blockchain startup battling fake video & images', year: '2021', href: 'https://verda.ai' },
  { label: 'hustle',      title: 'Bootstrapped crypto transfer',   detail: '30 users · $80k processed',                       year: '2023', href: 'https://stellar-transfer.web.app/' },
  { label: 'award',       title: '1st — Expedia Global Hackathon', detail: 'NLP travel planning bot · 160 participants',      year: '2021' },
  { label: 'open source', title: 'GraphQL-Flask Authentication',   detail: 'Contributor to the auth library',                 href: 'https://github.com/rscarrera27/Flask-GraphQL-Auth/' },
];

const desktopIcons = [
  { id: 'work',    label: 'Work',         kind: 'folder' as const, badge: workEntries.length },
  { id: 'blog',    label: 'Blog',         kind: 'folder' as const, badge: blogEntries.length },
  { id: 'signal',  label: 'Signal',       kind: 'folder' as const, badge: signals.length },
  { id: 'contact', label: 'Contact.txt',  kind: 'doc'    as const },
  { id: 'readme',  label: 'README.txt',   kind: 'doc'    as const },
  { id: 'snake',   label: 'Snake',        kind: 'app'    as const, glyph: '🐍', color: '#22C55E' },
];
---
<div class="dw-boot" aria-hidden="true">
  <div class="dw-boot-half dw-boot-top"></div>
  <div class="dw-boot-half dw-boot-bot"></div>
  <div class="dw-boot-line"></div>
</div>

<MenuBar />

<main class="dw-desktop" aria-label="Desktop">
  <div class="dw-icon-grid">
    {desktopIcons.map((ic) => (
      <DesktopIcon
        id={ic.id}
        label={ic.label}
        kind={ic.kind}
        badge={ic.badge}
        glyph={ic.glyph}
        color={ic.color}
      />
    ))}
  </div>

  <HeroPlate />
</main>

<ReadmeWindow />
<WorkWindow entries={workEntries} />
<SignalWindow items={signals} />
<ContactWindow />
<SnakeWindow />
<BlogWindow />
<AdminWindow />

<Dock />

<style>
  .dw-boot {
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    overflow: hidden;
  }
  .dw-boot.is-done { display: none; }
  .dw-boot-half {
    position: absolute;
    left: 0;
    right: 0;
    height: 50%;
    background: #000;
    will-change: transform;
  }
  .dw-boot-top {
    top: 0;
    animation: dw-boot-open-top 900ms cubic-bezier(0.6, 0.02, 0.32, 1) 320ms forwards;
  }
  .dw-boot-bot {
    bottom: 0;
    animation: dw-boot-open-bot 900ms cubic-bezier(0.6, 0.02, 0.32, 1) 320ms forwards;
  }
  .dw-boot-line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: #eaf5ff;
    box-shadow:
      0 0 6px 1px rgba(180, 220, 255, 0.9),
      0 0 22px 6px rgba(120, 190, 255, 0.55);
    transform: scaleX(0.02);
    transform-origin: 50% 50%;
    animation:
      dw-boot-line-in 260ms ease-out 40ms forwards,
      dw-boot-line-out 160ms ease-in 320ms forwards;
  }
  @keyframes dw-boot-open-top {
    from { transform: translateY(0); }
    to   { transform: translateY(-100%); }
  }
  @keyframes dw-boot-open-bot {
    from { transform: translateY(0); }
    to   { transform: translateY(100%); }
  }
  @keyframes dw-boot-line-in {
    from { transform: scaleX(0.02); opacity: 1; }
    to   { transform: scaleX(1); opacity: 1; }
  }
  @keyframes dw-boot-line-out {
    from { opacity: 1; transform: scaleX(1); }
    to   { opacity: 0; transform: scaleX(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .dw-boot { display: none; }
  }
  .dw-desktop {
    position: fixed;
    top: 28px;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    z-index: 1;
  }
  .dw-icon-grid {
    position: absolute;
    top: 24px;
    right: 24px;
    display: grid;
    grid-template-columns: repeat(1, 84px);
    gap: 12px;
    justify-items: center;
  }
  @media (max-width: 768px) {
    .dw-icon-grid {
      top: 12px;
      right: 8px;
      grid-template-columns: repeat(1, 64px);
      gap: 8px;
    }
  }
</style>

<script>
  import '../scripts/desktop.ts';

  const boot = document.querySelector<HTMLElement>('.dw-boot');
  if (boot) {
    window.setTimeout(() => boot.classList.add('is-done'), 1400);
  }
</script>
