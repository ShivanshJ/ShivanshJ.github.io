---
// Hidden admin window. Only opens (and only fetches data) when the
// visitor loads the page with `?admin=<TOKEN>`. No visible desktop icon
// means casual visitors don't even know the panel exists.
import Window from '../desktop/Window.astro';
import { site } from '../../data/site';

const endpoint = site.analyticsEndpoint;
---
<Window id="admin" title="Analytics" x={80} y={60} width={860} height={620}>
  <div class="dw-adm">
    <p class="dw-adm-status" id="dw-adm-status">idle</p>

    <div class="dw-adm-totals" id="dw-adm-totals" hidden></div>

    <div class="dw-adm-grid" id="dw-adm-grid" hidden>
      <section class="dw-adm-panel">
        <h4 class="dw-adm-title">by campaign</h4>
        <table id="dw-adm-tbl-campaign"><thead>
          <tr><th>campaign</th><th class="n">hits</th><th class="n">uniq</th><th>first</th><th>last</th></tr>
        </thead><tbody></tbody></table>
      </section>

      <section class="dw-adm-panel">
        <h4 class="dw-adm-title">by country</h4>
        <table id="dw-adm-tbl-country"><thead>
          <tr><th>country</th><th class="n">n</th></tr>
        </thead><tbody></tbody></table>
      </section>

      <section class="dw-adm-panel">
        <h4 class="dw-adm-title">by browser</h4>
        <table id="dw-adm-tbl-browser"><thead>
          <tr><th>browser</th><th class="n">n</th></tr>
        </thead><tbody></tbody></table>
      </section>

      <section class="dw-adm-panel">
        <h4 class="dw-adm-title">by os</h4>
        <table id="dw-adm-tbl-os"><thead>
          <tr><th>os</th><th class="n">n</th></tr>
        </thead><tbody></tbody></table>
      </section>

      <section class="dw-adm-panel dw-adm-panel-wide">
        <h4 class="dw-adm-title">top referrers</h4>
        <table id="dw-adm-tbl-referrer"><thead>
          <tr><th>referrer</th><th class="n">n</th></tr>
        </thead><tbody></tbody></table>
      </section>

      <section class="dw-adm-panel dw-adm-panel-wide">
        <h4 class="dw-adm-title">recent visits</h4>
        <table id="dw-adm-tbl-recent"><thead>
          <tr><th>when</th><th>campaign</th><th>where</th><th>browser</th><th>referrer</th></tr>
        </thead><tbody></tbody></table>
      </section>
    </div>
  </div>
</Window>

<style>
  .dw-adm {
    font-family: "Geist Mono Variable", ui-monospace, monospace;
    color: var(--text);
    font-size: 13px;
  }
  .dw-adm-status {
    margin: 0 0 16px;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--muted);
  }
  .dw-adm-status.ok  { color: var(--accent); }
  .dw-adm-status.err { color: #FF3B30; }

  .dw-adm-totals {
    display: flex;
    gap: 32px;
    margin-bottom: 24px;
    padding: 18px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }
  .dw-adm-tot {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .dw-adm-tot-value {
    font-size: 28px;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .dw-adm-tot-label {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
  }

  .dw-adm-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .dw-adm-panel-wide { grid-column: 1 / -1; }
  .dw-adm-panel {
    padding: 14px 16px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
  }
  .dw-adm-title {
    margin: 0 0 10px;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--muted);
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .dw-adm-title::before {
    content: "";
    display: inline-block;
    width: 6px;
    height: 6px;
    background: var(--accent);
  }

  .dw-adm table {
    width: 100%;
    border-collapse: collapse;
    font-size: 12px;
  }
  .dw-adm th, .dw-adm td {
    text-align: left;
    padding: 5px 6px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .dw-adm th {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--muted);
    font-weight: 600;
  }
  .dw-adm td { font-variant-numeric: tabular-nums; }
  .dw-adm td.n, .dw-adm th.n { text-align: right; }
  .dw-adm td.hi { color: var(--accent); font-weight: 700; }
  .dw-adm tbody tr:last-child td { border-bottom: 0; }
  .dw-adm .empty {
    color: var(--muted);
    text-align: center;
    padding: 12px;
  }
</style>

<script define:vars={{ endpoint }}>
  // Only activate when the page URL has ?admin=<TOKEN>.
  const key = new URLSearchParams(location.search).get('admin');
  if (!key) {
    // no key → do nothing; window stays hidden, no fetch
  } else {
    const win = document.getElementById('dw-window-admin');
    const status = document.getElementById('dw-adm-status');
    const totals = document.getElementById('dw-adm-totals');
    const grid = document.getElementById('dw-adm-grid');

    // Open the window using the same z-index counter logic used elsewhere
    const openIt = () => {
      if (!win) return;
      win.classList.add('is-open');
      const zNow = Math.max(...Array.from(document.querySelectorAll('.dw-window'))
        .map((w) => parseInt(w.style.zIndex || '100', 10))) + 1;
      win.style.zIndex = String(zNow);
      // center it (menu bar 28, dock ~90)
      const w = parseFloat(win.style.width) || 860;
      const h = parseFloat(win.style.height) || 620;
      win.style.left = `${Math.max(8, (window.innerWidth - w) / 2)}px`;
      win.style.top = `${Math.max(36, 28 + (window.innerHeight - 118 - h) / 2)}px`;
    };

    const setStatus = (text, cls) => {
      if (!status) return;
      status.textContent = text;
      status.className = 'dw-adm-status' + (cls ? ' ' + cls : '');
    };

    const fmtTs = (ms) => {
      const now = Date.now();
      const diff = (now - ms) / 1000;
      if (diff < 60)    return `${Math.floor(diff)}s ago`;
      if (diff < 3600)  return `${Math.floor(diff / 60)}m ago`;
      if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
      const d = new Date(ms);
      return d.toLocaleDateString(undefined, { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    };
    const fmtRef = (r) => {
      if (!r) return '—';
      try { return new URL(r).hostname; } catch { return String(r).slice(0, 40); }
    };
    const setRows = (tblId, rows, cols) => {
      const tbody = document.querySelector(`#${tblId} tbody`);
      if (!tbody) return;
      tbody.innerHTML = '';
      if (!rows || rows.length === 0) {
        tbody.insertAdjacentHTML('beforeend', `<tr><td class="empty" colspan="${cols.length}">no data yet</td></tr>`);
        return;
      }
      for (const row of rows) {
        tbody.insertAdjacentHTML('beforeend',
          '<tr>' + cols.map((c) => `<td class="${c.cls ?? ''}">${c.val(row)}</td>`).join('') + '</tr>');
      }
    };

    openIt();
    setStatus('loading…');

    fetch(`${endpoint}/stats?key=${encodeURIComponent(key)}`, { mode: 'cors' })
      .then(async (r) => {
        if (r.status === 401) throw new Error('bad admin key');
        if (!r.ok) throw new Error(`worker ${r.status}`);
        return r.json();
      })
      .then((data) => {
        setStatus('connected', 'ok');
        totals.hidden = false;
        grid.hidden = false;

        totals.innerHTML = `
          <div class="dw-adm-tot"><div class="dw-adm-tot-value">${data.totals.total ?? 0}</div><div class="dw-adm-tot-label">total hits</div></div>
          <div class="dw-adm-tot"><div class="dw-adm-tot-value">${data.totals.uniques ?? 0}</div><div class="dw-adm-tot-label">unique visitors</div></div>
          <div class="dw-adm-tot"><div class="dw-adm-tot-value">${data.by_campaign.filter((c) => c.campaign !== '(no campaign)').length}</div><div class="dw-adm-tot-label">campaigns tracked</div></div>
        `;

        setRows('dw-adm-tbl-campaign', data.by_campaign, [
          { val: (r) => `<span class="hi">${r.campaign}</span>` },
          { val: (r) => r.hits,    cls: 'n' },
          { val: (r) => r.uniques, cls: 'n' },
          { val: (r) => fmtTs(r.first_seen) },
          { val: (r) => fmtTs(r.last_seen) },
        ]);
        setRows('dw-adm-tbl-country',  data.by_country,  [{ val: (r) => r.country }, { val: (r) => r.n, cls: 'n' }]);
        setRows('dw-adm-tbl-browser',  data.by_browser,  [{ val: (r) => r.browser }, { val: (r) => r.n, cls: 'n' }]);
        setRows('dw-adm-tbl-os',       data.by_os,       [{ val: (r) => r.os },      { val: (r) => r.n, cls: 'n' }]);
        setRows('dw-adm-tbl-referrer', data.by_referrer, [{ val: (r) => fmtRef(r.referrer) }, { val: (r) => r.n, cls: 'n' }]);
        setRows('dw-adm-tbl-recent',   data.recent,      [
          { val: (r) => fmtTs(r.ts) },
          { val: (r) => r.campaign ?? '—' },
          { val: (r) => [r.city, r.country].filter(Boolean).join(', ') || '—' },
          { val: (r) => `${r.browser} / ${r.os}` },
          { val: (r) => fmtRef(r.referrer) },
        ]);
      })
      .catch((err) => setStatus(`error: ${err.message}`, 'err'));
  }
</script>
