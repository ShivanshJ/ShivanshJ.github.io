---
// Translucent macOS-style menu bar pinned to the top of the viewport.
import { site } from '../../data/site.ts';
---
<div class="dw-menubar" role="menubar">
  <div class="dw-menubar-left">
    <button type="button" class="dw-menu-item dw-apple" aria-label="Apple menu">
      <svg viewBox="0 0 20 20" width="14" height="14" fill="currentColor" aria-hidden="true">
        <path d="M13.6 10.6c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.6-1.3-.1-2.5.8-3.2.8-.7 0-1.7-.8-2.8-.7-1.4 0-2.7.8-3.5 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7 1.3 0 1.7.7 2.8.7 1.2 0 1.9-1 2.6-2 .8-1.1 1.2-2.3 1.2-2.3-.1 0-2.3-.9-2.5-3.4M11.6 4.2c.6-.7 1-1.7.9-2.7-.8 0-1.9.5-2.5 1.3-.5.6-1 1.6-.9 2.6.9.1 1.9-.5 2.5-1.2"/>
      </svg>
    </button>
    <button type="button" class="dw-menu-item dw-menu-item-bold" data-scramble>Portfolio</button>
    <button type="button" class="dw-menu-item dw-menu-hide-mobile" data-scramble>File</button>
    <button type="button" class="dw-menu-item dw-menu-hide-mobile" data-scramble>Edit</button>
    <button type="button" class="dw-menu-item dw-menu-hide-mobile" data-scramble>View</button>
    <button type="button" class="dw-menu-item dw-menu-hide-mobile" data-scramble>Window</button>
    <button type="button" class="dw-menu-item dw-menu-hide-mobile" data-scramble>Help</button>
  </div>
  <div class="dw-menubar-right">
    <span class="dw-menu-icon" aria-hidden="true">􀋚</span>
    <span class="dw-menu-icon" aria-hidden="true">􀹖</span>
    <span class="dw-menu-item" id="dw-clock">—</span>
  </div>
</div>

<div class="dw-admin-modal" id="dw-admin-modal" hidden aria-hidden="true">
  <div class="dw-admin-backdrop" data-admin-close></div>
  <div class="dw-admin-box" role="dialog" aria-modal="true" aria-labelledby="dw-admin-label">
    <label class="dw-admin-label" id="dw-admin-label" for="dw-admin-input">FOR ADMINS' EYES ONLY</label>
    <form class="dw-admin-form" id="dw-admin-form" autocomplete="off">
      <input
        class="dw-admin-input"
        id="dw-admin-input"
        type="password"
        name="token"
        spellcheck="false"
        autocapitalize="off"
        autocomplete="off"
        placeholder="paste token"
      />
      <button type="submit" class="dw-admin-submit">UNLOCK</button>
    </form>
    <div class="dw-admin-error" id="dw-admin-error" hidden>× invalid token</div>
  </div>
</div>

<style>
  .dw-menubar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
    background: rgba(20, 20, 20, 0.65);
    backdrop-filter: blur(20px) saturate(180%);
    -webkit-backdrop-filter: blur(20px) saturate(180%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    z-index: 1000;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Geist Variable", sans-serif;
    font-size: 13px;
    color: rgba(255, 255, 255, 0.92);
  }
  .dw-menubar-left,
  .dw-menubar-right {
    display: flex;
    align-items: center;
    gap: 2px;
  }
  .dw-menu-item {
    background: transparent;
    border: 0;
    color: inherit;
    font: inherit;
    padding: 3px 10px;
    border-radius: 4px;
    cursor: default;
    line-height: 1;
  }
  .dw-menu-item:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .dw-menu-item-bold { font-weight: 600; }
  .dw-apple { padding: 4px 8px; display: inline-flex; align-items: center; cursor: pointer; }
  .dw-menu-icon {
    padding: 3px 8px;
    font-size: 12px;
    opacity: 0.85;
  }
  #dw-clock {
    font-variant-numeric: tabular-nums;
    min-width: 130px;
    text-align: right;
  }
  @media (max-width: 768px) {
    .dw-menu-hide-mobile { display: none; }
    .dw-menu-icon { display: none; }
    .dw-menubar { padding: 0 8px; }
    #dw-clock { min-width: 0; font-size: 12px; padding: 3px 6px; }
    .dw-menu-item { padding: 3px 6px; }
  }

  /* -- Admin unlock modal ------------------------------------------------ */
  .dw-admin-modal {
    position: fixed;
    inset: 0;
    z-index: 2000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dw-admin-modal[hidden] { display: none; }
  .dw-admin-backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .dw-admin-box {
    position: relative;
    width: 360px;
    max-width: calc(100vw - 32px);
    padding: 22px 22px 18px;
    background: rgba(44, 44, 44, 0.95);
    backdrop-filter: blur(30px) saturate(180%);
    -webkit-backdrop-filter: blur(30px) saturate(180%);
    border: 1px solid var(--accent);
    border-radius: 8px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
    color: rgba(255, 255, 255, 0.92);
  }
  .dw-admin-label {
    display: block;
    font-family: "JetBrains Mono", "SF Mono", ui-monospace, monospace;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--accent);
    margin-bottom: 10px;
  }
  .dw-admin-form {
    display: flex;
    gap: 8px;
  }
  .dw-admin-input {
    flex: 1 1 auto;
    min-width: 0;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 4px;
    color: #fff;
    font-family: "JetBrains Mono", "SF Mono", ui-monospace, monospace;
    font-size: 13px;
    padding: 8px 10px;
    outline: none;
    transition: border-color 120ms, box-shadow 120ms;
  }
  .dw-admin-input:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 2px rgba(76, 139, 245, 0.25);
  }
  .dw-admin-submit {
    background: transparent;
    border: 1px solid var(--accent);
    color: var(--accent);
    font-family: "JetBrains Mono", "SF Mono", ui-monospace, monospace;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    padding: 0 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: background 120ms, color 120ms;
  }
  .dw-admin-submit:hover,
  .dw-admin-submit:focus-visible {
    background: var(--accent);
    color: #0b0b0b;
    outline: none;
  }
  .dw-admin-submit:disabled {
    opacity: 0.5;
    cursor: default;
  }
  .dw-admin-error {
    margin-top: 10px;
    font-family: "JetBrains Mono", "SF Mono", ui-monospace, monospace;
    font-size: 12px;
    color: #ff5a5a;
  }
</style>

<script>
  const el = document.getElementById('dw-clock');
  const tick = () => {
    if (!el) return;
    const d = new Date();
    const day = d.toLocaleDateString(undefined, { weekday: 'short' });
    const date = d.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
    const time = d.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' });
    el.textContent = `${day} ${date}  ${time}`;
  };
  tick();
  setInterval(tick, 1000 * 15);
</script>

<script define:vars={{ endpoint: site.analyticsEndpoint }}>
  (() => {
    const STORAGE_KEY = 'dw-admin-token';
    const apple = document.querySelector('.dw-apple');
    const modal = document.getElementById('dw-admin-modal');
    const form = document.getElementById('dw-admin-form');
    const input = document.getElementById('dw-admin-input');
    const submit = form ? form.querySelector('.dw-admin-submit') : null;
    const errEl = document.getElementById('dw-admin-error');
    if (!apple || !modal || !form || !input || !errEl) return;

    const goAdmin = (token) => {
      window.location.href = '/?admin=' + encodeURIComponent(token);
    };

    const openModal = () => {
      errEl.hidden = true;
      input.value = '';
      modal.hidden = false;
      modal.setAttribute('aria-hidden', 'false');
      try { if (typeof window.__dwChirp === 'function') window.__dwChirp(); } catch (_) {}
      setTimeout(() => input.focus(), 0);
    };

    const closeModal = () => {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      if (submit) submit.disabled = false;
    };

    apple.addEventListener('click', (e) => {
      e.preventDefault();
      let stored = null;
      try { stored = localStorage.getItem(STORAGE_KEY); } catch (_) {}
      if (stored) {
        goAdmin(stored);
        return;
      }
      openModal();
    });

    modal.addEventListener('click', (e) => {
      const t = e.target;
      if (t instanceof HTMLElement && t.hasAttribute('data-admin-close')) closeModal();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const token = (input.value || '').trim();
      if (!token) return;
      errEl.hidden = true;
      if (submit) submit.disabled = true;
      try {
        const res = await fetch(
          endpoint + '/stats?key=' + encodeURIComponent(token),
          { mode: 'cors' }
        );
        if (res.ok) {
          try { localStorage.setItem(STORAGE_KEY, token); } catch (_) {}
          goAdmin(token);
          return;
        }
        errEl.textContent = '× invalid token';
        errEl.hidden = false;
      } catch (_) {
        errEl.textContent = '× network error';
        errEl.hidden = false;
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  })();
</script>
