---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '../styles/global.css';
import '../styles/desktop.css';
import PixelSky from '../components/PixelSky.astro';
import { seo, site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = seo.title,
  description = seo.description,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={site.themeColor} />
  </head>
  <body class="text-text">
    <PixelSky />
    <slot />
    <script>
      import '../scripts/scramble.ts';
      import '../scripts/highlight-prose.ts';
    </script>
    <script define:vars={{ analyticsEndpoint: site.analyticsEndpoint }}>
      // Beacon inlined so the endpoint URL can come from src/data/site.ts
      // at build time (no separate constant to keep in sync).
      (() => {
        const params = new URLSearchParams(location.search);
        if (params.get('dnt') === '1') { localStorage.setItem('dnt', '1'); return; }
        if (localStorage.getItem('dnt') === '1') return;
        // Viewing your own admin panel shouldn't count as a hit.
        if (params.has('admin')) return;
        let sid = localStorage.getItem('sid');
        if (!sid) {
          sid = (crypto && crypto.randomUUID)
            ? crypto.randomUUID()
            : Math.random().toString(36).slice(2) + Date.now().toString(36);
          localStorage.setItem('sid', sid);
        }
        const campaign = params.get('cmp') || params.get('campaign') || null;
        const referrer = document.referrer || null;
        fetch(`${analyticsEndpoint}/hit`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ campaign, session_id: sid, referrer }),
          keepalive: true,
          mode: 'cors',
        }).catch(() => {});
      })();
    </script>
  </body>
</html>
